<script id="merge-petunjuk-misi-canva">
/* Gabungan: petunjuk bertahap, misi M1-M3 per tim, link Canva, sandi ber-hash */
(()=>{
const $=id=>document.getElementById(id);
const sv=(k,v)=>{try{localStorage.setItem(k,v);return true}catch(e){return false}};
const ld=k=>{try{return localStorage.getItem(k)||''}catch(e){return ''}};
/* ---------- sandi (disamarkan, tidak tertulis di layar) ---------- */
const cyrb53=(str,seed=0)=>{let h1=0xdeadbeef^seed,h2=0x41c6ce57^seed;for(let i=0,ch;i<str.length;i++){ch=str.charCodeAt(i);h1=Math.imul(h1^ch,2654435761);h2=Math.imul(h2^ch,1597334677)}h1=Math.imul(h1^(h1>>>16),2246822507)^Math.imul(h2^(h2>>>13),3266489909);h2=Math.imul(h2^(h2>>>16),2246822507)^Math.imul(h1^(h1>>>13),3266489909);return 4294967296*(2097151&h2)+(h1>>>0)};
const hh=s=>String(cyrb53('energi-detektif|'+s));
const DEFAULT_HASH='8826059000880458';
window.pinOk=v=>hh(String(v))===(ld('detektifEnergiPinHash')||DEFAULT_HASH);
/* ---------- gaya ---------- */
const st=document.createElement('style');
st.textContent=`.hc{background:#fff8dc;color:#2a1700;border-radius:12px;padding:10px;text-align:center;margin-top:8px;font-weight:700;animation:hcFlip .5s}.hc .big{font-size:2.4rem;display:block}@keyframes hcFlip{from{transform:rotateY(90deg)}}button.answer[data-out="1"]{display:none!important}.tm{margin:8px 0;font-size:.85rem}.tm-b{display:inline-block;border:1.5px solid currentColor;border-radius:999px;padding:2px 9px;margin:0 6px 4px 0;font-weight:800}.tm-b.d{color:#1f8a4c}.tm-sum{margin-top:12px;font-weight:700}`;
document.head.appendChild(st);
/* ---------- petunjuk bertahap ---------- */
const COST=[3,8,15];
function pick2Wrong(c,btns){const idx=btns.map((_,i)=>i).filter(i=>i!==c.answer);for(let i=idx.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[idx[i],idx[j]]=[idx[j],idx[i]]}return idx.slice(0,2)}
function cardHTML(c){const tp=window.topicOf?window.topicOf(c):{art:'🔎⚡',note:'Cari petunjuk perubahan bentuk energi.'};return '<div class="hc"><span class="big">'+tp.art+'</span>'+tp.note+'</div>'}
/* mode tunggal */
let sh=0;
const hb=()=>$('hintBtn');
const LBL=['💡 Petunjuk 1: kata kunci','🃏 Petunjuk 2: kartu gambar','✂️ Petunjuk 3: kurangi pilihan','✔ Petunjuk habis'];
function labelSh(){if(hb())hb().textContent=LBL[sh]}
if(hb()){
 hb().onclick=()=>{if(answered||sh>=3)return;const c=cases.find(x=>x.id===currentId);if(!c)return;sh++;
  const box=$('hintBox');box.classList.remove('hidden');
  if(sh===1)box.textContent='🔑 '+c.hint;
  else if(sh===2)box.insertAdjacentHTML('beforeend',cardHTML(c));
  else{const btns=[...$('answers').querySelectorAll('button.answer')];pick2Wrong(c,btns).forEach(i=>btns[i].dataset.out='1')}
  hints++;labelSh();if(sh>=3)hb().disabled=true;renderCases()};
 new MutationObserver(()=>{sh=0;labelSh();const c=cases.find(x=>x.id===currentId);if(c&&c.subchapter&&$('gameTitle'))$('gameTitle').textContent=c.subchapter}).observe($('gameQuestion'),{childList:true,characterData:true,subtree:true});
 labelSh();
}
/* mode 4 tim */
const M1=150,MT=['Kumpulkan '+M1+' poin.','Jawab benar 3 ronde berturut-turut.','Jelaskan alasan jawabanmu kepada guru.'];
window.TM=[0,1,2,3].map(()=>({md:[0,0,0],streak:0}));window.roundHintCost=[0,0,0,0];window.roundHintStage=[0,0,0,0];
function mHTML(n){const s=TM[n];const cur=s.md.findIndex(v=>!v);
 let h=[0,1,2].map(j=>'<span class="tm-b'+(s.md[j]?' d':'')+'">'+(s.md[j]?'✅':(j>0&&!s.md[j-1]?'🔒':'🎯'))+' M'+(j+1)+'</span>').join('');
 h+=cur>=0?'<div>Misi '+(cur+1)+': '+MT[cur]+'</div>':'<div style="color:#1f8a4c">🏅 Semua misi tuntas!</div>';
 if(s.md[1]&&!s.md[2])h+='<div style="margin-top:6px">🎤 Jelaskan alasanmu ke guru, lalu guru menyetujui:</div><input type="password" class="tm-pin" placeholder="Sandi guru" style="max-width:150px"> <button class="btn ghost small tm-ok" data-t="'+n+'">✓ Guru setuju</button>';
 return h}
function refreshM(){document.querySelectorAll('#playerGrid .tm').forEach(el=>{el.innerHTML=mHTML(+el.dataset.tm)})}
function decorate(){
 [...$('playerGrid').children].forEach(card=>{
  if(!card.classList.contains('player-card'))return;
  const n=+card.dataset.team,c=cases.find(x=>x.id===+card.dataset.caseId);if(!c)return;
  const tag=card.querySelector('.tag');if(tag&&c.subchapter)tag.textContent=c.subchapter;
  card.querySelector('h3').insertAdjacentHTML('afterend','<div class="tm" data-tm="'+n+'">'+mHTML(n)+'</div>');
  const old=card.querySelector('.team-hint-btn');if(!old)return;
  const b=old.cloneNode(true);old.replaceWith(b);b.disabled=false;b.textContent=LBL[0];
  card.querySelector('.team-hints').textContent='Petunjuk: 0/3 · biaya dipotong dari poin ronde ini';
  b.onclick=()=>{if(multiLocked||card.dataset.chosen!==''||roundHintStage[n]>=3)return;
   const k=roundHintStage[n];roundHintCost[n]+=COST[k];roundHintStage[n]=k+1;
   const box=card.querySelector('.team-hint-text');box.classList.remove('hidden');
   if(k===0)box.textContent='🔑 '+c.hint;
   else if(k===1)box.insertAdjacentHTML('beforeend',cardHTML(c));
   else{const btns=[...card.querySelectorAll('button.answer')];pick2Wrong(c,btns).forEach(i=>btns[i].dataset.out='1')}
   card.querySelector('.team-hints').textContent='Petunjuk: '+(k+1)+'/3 · potongan '+roundHintCost[n]+' poin';
   b.textContent=LBL[k+1];if(k+1>=3)b.disabled=true};
 });
}
const prevRender=renderMultiRound;
renderMultiRound=function(){
 if(multiRound===0){window.TM=[0,1,2,3].map(()=>({md:[0,0,0],streak:0}));multiPool=multiPool.slice(0,Math.floor(multiPool.length/4)*4)}
 window.roundHintCost=[0,0,0,0];window.roundHintStage=[0,0,0,0];
 prevRender();decorate()};
const prevFin=finishMultiRound;
finishMultiRound=function(timeout){
 const was=multiLocked;prevFin(timeout);if(was)return;
 document.querySelectorAll('#playerGrid .player-card').forEach(card=>{const n=+card.dataset.team,s=TM[n];
  const ok=!!card.querySelector('.feedback.ok');s.streak=ok?s.streak+1:0;
  if(multiScores[n]>=M1&&!s.md[0])s.md[0]=1;
  if(s.md[0]&&s.streak>=3&&!s.md[1])s.md[1]=1});
 refreshM()};
document.addEventListener('click',e=>{const b=e.target.closest('.tm-ok');if(!b)return;
 const n=+b.dataset.t,inp=b.parentElement.querySelector('.tm-pin');
 if(window.pinOk(inp.value)){TM[n].md[2]=1;refreshM()}else{inp.value='';inp.placeholder='Sandi salah'}});
if($('multiNext'))$('multiNext').addEventListener('click',()=>setTimeout(()=>{
 const p=document.querySelector('#playerGrid .panel');
 if(!p||p.querySelector('.tm-sum')||!/Permainan selesai/.test($('multiRoundLabel').textContent))return;
 p.insertAdjacentHTML('beforeend','<div class="tm-sum"><p>Misi per tim:</p>'+TM.map((s,n)=>teamIcons[n]+' '+teamNames[n]+': '+s.md.map((v,j)=>(v?'✅':'⬜')+' M'+(j+1)).join(' ')).join('<br>')+'</div>')},30));
/* ---------- link kembali ke Canva ---------- */
const okLink=()=>/^https?:\/\//.test(ld('detektifEnergiCanva'));
function toCanva(){const u=ld('detektifEnergiCanva');if(!/^https?:\/\//.test(u))return;try{window.close()}catch(e){}setTimeout(()=>{location.href=u},300)}
['backHome','backMulti','teacherOpen'].forEach(id=>{const e=$(id);if(!e)return;const b=document.createElement('button');b.className='btn ghost small cv';b.textContent='⬅ Kembali ke Canva';b.style.display='none';b.onclick=toCanva;e.insertAdjacentElement('afterend',b)});
function syncCv(){document.querySelectorAll('.cv').forEach(b=>b.style.display=okLink()?'':'none')}
syncCv();
const prevPop=populateSettings;
populateSettings=function(){prevPop();if($('canvaLinkInput'))$('canvaLinkInput').value=ld('detektifEnergiCanva')};
$('saveSettings').addEventListener('click',()=>{
 let extra=[];
 if($('canvaLinkInput')){const v=$('canvaLinkInput').value.trim();if(!v||/^https?:\/\//.test(v)){sv('detektifEnergiCanva',v);syncCv()}else extra.push('Link Canva harus diawali https://')}
 const np=$('newPinInput')?$('newPinInput').value.trim():'';
 if(np){if(np.length>=4){sv('detektifEnergiPinHash',hh(np));$('newPinInput').value='';extra.push('Sandi diperbarui')}else extra.push('Sandi baru minimal 4 karakter')}
 if(extra.length)setTimeout(()=>{const m=$('settingsMessage');if(m)m.textContent=(m.textContent?m.textContent+' · ':'')+extra.join(' · ')},0)});
