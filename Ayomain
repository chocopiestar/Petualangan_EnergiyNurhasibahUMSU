old{background:var(--site-secondary);color:var(--site-on-secondary)}.btn.ghost{background:light-dark(#EEF1FC,#29324C);color:light-dark(#273A7A,#E7EBFF)}.btn.small{padding:8px 11px;font-size:.84rem}.btn:disabled{opacity:.4;cursor:not-allowed;transform:none}.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}.stat{background:light-dark(#F3F5FC,#222D48);border-radius:15px;padding:13px}.stat b{font-size:1.35rem;display:block}.stat span{font-size:.8rem;color:light-dark(#65708D,#B8C1DC)}.section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.section-head h2{margin:0}.cases{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.case{border:1px solid light-dark(#DDE3F3,#35405E);background:light-dark(#FBFCFF,#202941);border-radius:18px;padding:16px;display:flex;gap:12px;align-items:flex-start}.case .emoji{width:48px;height:48px;border-radius:15px;background:light-dark(#FFF0C9,#453B2B);display:grid;place-items:center;font-size:26px;flex-shrink:0}.case p{font-size:.9rem;line-height:1.45;color:light-dark(#626D87,#C0C9E1);margin-bottom:12px}.case .btn{width:100%}.side-stack{display:grid;gap:18px;align-content:start}.list{display:grid;gap:12px}.list-item{display:flex;gap:11px;align-items:flex-start}.bubble{width:34px;height:34px;border-radius:11px;background:light-dark(#E9EDFF,#2C3657);display:grid;place-items:center;flex-shrink:0}.list-item p{margin:3px 0 0;font-size:.9rem;line-height:1.4;color:light-dark(#66718B,#C1C9DE)}.note{border-radius:14px;background:light-dark(#FFF5D9,#393322);color:light-dark(#6B4B0D,#F9DEA0);padding:13px;font-size:.88rem;line-height:1.5}.muted{color:light-dark(#69748D,#B9C3DD)}.hidden{display:none!important}.game-wrap{max-width:1000px;margin:auto}.game-top{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:15px}.progress{height:9px;border-radius:99px;background:light-dark(#E5E9F5,#303954);overflow:hidden;margin:12px 0 20px}.progress span{display:block;height:100%;width:0;background:var(--site-secondary);transition:width .25s}.question{font-size:clamp(1.25rem,3vw,1.8rem);line-height:1.3;margin:15px 0}.clue{border:1px dashed light-dark(#9DAAE0,#6374B4);border-radius:14px;padding:12px;margin:14px 0;background:light-dark(#F5F7FF,#222C47)}.answers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:18px}.answer{padding:16px;border:2px solid light-dark(#DFE4F3,#3A4565);background:light-dark(#FFF,#202941);border-radius:15px;text-align:left;font:inherit;font-weight:850;color:inherit;cursor:pointer}.answer:hover{border-color:#7888D7}.answer.correct{border-color:#2D9A68;background:light-dark(#E4F8EC,#173C32)}.answer.wrong{border-color:#D76565;background:light-dark(#FFF0F0,#472A35)}.feedback{padding:14px;border-radius:14px;margin-top:15px;line-height:1.5}.feedback.ok{background:light-dark(#E4F8EC,#173C32);color:light-dark(#17603F,#B6F3D0)}.feedback.no{background:light-dark(#FFF0F0,#472A35);color:light-dark(#8C3030,#FFD1D1)}.timer{font-variant-numeric:tabular-nums;font-size:1.1rem;font-weight:900;background:light-dark(#FFF2D4,#3B3325);padding:9px 13px;border-radius:12px}.mission{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.mission-card{border:1px solid light-dark(#DFE4F3,#36415F);border-radius:16px;padding:14px;background:light-dark(#FBFCFF,#202941)}.mission-card label{display:block;font-weight:850;margin-bottom:8px}.mission-card select,.mission-card input,.pin-input{width:100%;padding:11px;border:1px solid light-dark(#CCD4EA,#475474);border-radius:11px;background:light-dark(#FFF,#151D30);color:inherit;font:inherit}.player-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.player-card{border:1px solid light-dark(#DDE3F3,#36415F);border-radius:18px;padding:17px;background:light-dark(#FBFCFF,#202941)}.player-card h3{display:flex;justify-content:space-between;gap:8px}.player-card .answer{width:100%;margin-top:8px;padding:11px}.player-card .clue{font-size:.88rem}.footer{max-width:1120px;margin:20px auto 0;text-align:center;font-size:.78rem;color:light-dark(#7A849B,#9DA9C8)}.toast{margin-top:12px;font-weight:800;line-height:1.4}.tag{font-size:.75rem;font-weight:900;text-transform:uppercase;letter-spacing:.06em;color:light-dark(#58689C,#B7C5FF)}
