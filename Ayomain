<script>
/* Revisi prototipe: ilustrasi kartun, bank soal guru, audio, dan ronde tim yang adil. */
(()=>{
const style=document.createElement('style');style.textContent=`.cartoon-scene{display:flex;align-items:center;justify-content:center;gap:16px;min-height:150px;margin:14px 0;padding:16px;border-radius:20px;background:linear-gradient(135deg,#eef3ff,#fff3d8);border:2px solid #dce4fb}.cartoon-scene svg{width:min(180px,38%);height:132px;flex-shrink:0}.cartoon-caption{font-weight:900;color:#253b80;font-size:1rem;line-height:1.4}.cartoon-caption small{display:block;margin-top:6px;color:#536184;font-weight:650;font-size:.85rem}.audio-btn{margin:8px 0}.hint-row{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.team-hints{font-size:.8rem;color:#596789;margin:7px 0}.question-editor{margin-top:22px;padding-top:18px;border-top:2px dashed #d9e0f4}.question-editor input,.question-editor textarea,.question-editor select{width:100%;padding:10px;border:1px solid #ccd4ea;border-radius:10px;background:light-dark(#fff,#151d30);color:inherit;font:inherit;margin:5px 0 10px}.question-editor label{font-weight:800}.editor-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.round-reveal{margin:12px 0;padding:12px;border-radius:12px;background:light-dark(#fff5d9,#393322);font-weight:800}@media(max-width:540px){.cartoon-scene{flex-direction:column;text-align:center}.cartoon-scene svg{width:150px}.editor-grid{grid-template-columns:1fr}}`;document.head.appendChild(style);
const originalStartCase=startCase,originalRenderCases=renderCases;
const TOPIC_T={
 foto:{art:'🌱☀️',title:'Misi Tumbuhan',note:'Amati cahaya, air, dan daun yang bekerja bersama.',cls:'case-light'},
 surya:{art:'☀️🔋',title:'Misi Matahari',note:'Telusuri energi yang datang dari Matahari.',cls:'case-light'},
 air:{art:'💧⚙️',title:'Misi Air',note:'Ikuti aliran air yang dapat memutar sesuatu.',cls:'case-fan'},
 tubuh:{art:'🍚🚴',title:'Misi Tubuh',note:'Telusuri energi dari makanan untuk bergerak.',cls:'case-iron'},
 potensial:{art:'⛰️⬆️',title:'Misi Posisi',note:'Bandingkan tinggi dan rendahnya benda.',cls:'case-iron'},
 gerak:{art:'🌀💨',title:'Misi Gerak',note:'Perhatikan benda yang bergerak.',cls:'case-fan'},
 angin:{art:'🌬️🌀',title:'Misi Angin',note:'Ikuti angin yang dapat menggerakkan baling-baling.',cls:'case-fan'},
 bunyi:{art:'🔊🎵',title:'Misi Bunyi',note:'Perhatikan getaran yang sampai ke telinga.',cls:'case-speaker'},
 api:{art:'🔥🕯️',title:'Misi Api',note:'Amati bahan bakar yang berubah menjadi panas dan cahaya.',cls:'case-iron'},
 baterai:{art:'🔋🔦',title:'Misi Baterai',note:'Telusuri energi yang tersimpan di baterai.',cls:'case-flashlight'},
 panas:{art:'♨️🔥',title:'Misi Panas',note:'Rasakan panas yang berpindah atau dihasilkan.',cls:'case-iron'},
 cahaya:{art:'💡✨',title:'Misi Cahaya',note:'Amati cahaya yang membantu kita melihat.',cls:'case-light'},
 alam:{art:'♻️🌍',title:'Misi Energi Alam',note:'Pikirkan sumber energi yang dapat dipakai terus.',cls:'case-light'},
 umum:{art:'🔎⚡',title:'Misi Energi',note:'Cari petunjuk perubahan bentuk energi.',cls:'case-light'}};
const TOPIC_R=[['foto',/fotosintesis|tumbuhan|tanaman|daun/],['surya',/panel surya|matahari|surya/],['air',/tenaga air|aliran air|air mengalir|sungai|waduk|kincir/],['tubuh',/makanan|otot|bersepeda|berlari|tubuh|mengangkat/],['potensial',/potensial|ketinggian|lebih tinggi|bukit|\brak\b|busur|posisi/],['gerak',/kipas|blender|bola|menggelinding|mobil mainan/],['angin',/angin/],['bunyi',/bunyi|\bbel\b|drum|gitar|speaker|pengeras|mikrofon|radio|suara|musik/],['api',/lilin|kayu|dibakar|kompor gas|\bapi\b/],['baterai',/baterai|senter|ponsel|mengisi daya|isi daya/],['panas',/setrika|rice cooker|kompor|panci|panas|suhu|hangat|menggosok/],['cahaya',/lampu|cahaya|terang|\bled\b/],['alam',/terbarukan|alternatif/]];
function topicOf(c){const q=String(c.question||'').toLowerCase();for(const [k,r] of TOPIC_R)if(r.test(q))return TOPIC_T[k];return TOPIC_T.umum}
window.topicOf=topicOf;
function cartoon(c){const tp=topicOf(c);return `<div class="cartoon-scene" role="img" aria-label="Ilustrasi ${tp.title}"><div style="font-size:3rem;line-height:1.1">${tp.art}</div><div class="cartoon-caption">${tp.title}<small>${tp.note}</small></div></div>`}

function cartoonOld(c){const palette=['#f7c948','#4d83df','#f18b64','#62b68a','#9b80dc'];const col=palette[(c.id-1)%palette.length];let drawing='';if(c.id===1)drawing=`<path d="M90 20 L90 45" stroke="#4b5685" stroke-width="8" stroke-linecap="round"/><path d="M68 48 Q90 28 112 48 L126 83 Q90 102 54 83Z" fill="#fff0a8" stroke="#d99b25" stroke-width="4"/><circle cx="90" cy="62" r="16" fill="#ffd85c" stroke="#e7a928" stroke-width="4"/><path d="M38 105 L142 105" stroke="#6c7ca9" stroke-width="6" stroke-linecap="round"/>`;else if(c.id===2)drawing=`<circle cx="90" cy="65" r="43" fill="#d9e9ff" stroke="#3e68b6" stroke-width="5"/><circle cx="90" cy="65" r="8" fill="#3e68b6"/>${[0,120,240].map(a=>`<path d="M90 59 Q58 15 79 28 Q105 37 97 59Z" fill="${col}" stroke="#3e68b6" stroke-width="3" transform="rotate(${a} 90 65)"/>`).join('')}<path d="M90 109 L90 124 M67 124 L113 124" stroke="#3e68b6" stroke-width="6" stroke-linecap="round"/>`;else if(c.id===3)drawing=`<rect x="53" y="30" width="74" height="73" rx="15" fill="${col}" stroke="#9a4e42" stroke-width="4"/><circle cx="90" cy="65" r="23" fill="#fff1d4" stroke="#9a4e42" stroke-width="4"/><circle cx="90" cy="65" r="10" fill="#ef8a63"/><path d="M42 44 Q28 65 42 86 M138 44 Q152 65 138 86" fill="none" stroke="#3e68b6" stroke-width="5" stroke-linecap="round"/>`;else if(c.id===4)drawing=`<path d="M55 35 L112 35 L125 53 L88 70 L51 53Z" fill="${col}" stroke="#a85b32" stroke-width="4"/><path d="M51 53 L88 70 L88 86 L51 69Z" fill="#f5b544" stroke="#a85b32" stroke-width="4"/><path d="M88 70 L125 53 L125 69 L88 86Z" fill="#e87d49" stroke="#a85b32" stroke-width="4"/><path d="M67 20 Q60 12 68 5 M90 20 Q83 12 91 5 M113 20 Q106 12 114 5" fill="none" stroke="#e87d49" stroke-width="4" stroke-linecap="round"/>`;else drawing=`<rect x="61" y="24" width="58" height="91" rx="22" fill="#e4edff" stroke="#3e68b6" stroke-width="5"/><rect x="73" y="36" width="34" height="40" rx="13" fill="${col}" stroke="#3e68b6" stroke-width="3"/><path d="M80 83 L100 83" stroke="#3e68b6" stroke-width="4" stroke-linecap="round"/><path d="M90 10 L90 2 M45 28 L37 20 M135 28 L143 20" stroke="#e5a629" stroke-width="4" stroke-linecap="round"/>`;return `<div class="cartoon-scene" role="img" aria-label="Ilustrasi kartun ${c.title}"><svg viewBox="0 0 180 135" aria-hidden="true"><path d="M16 115 Q90 128 164 115" fill="none" stroke="#cbd6f2" stroke-width="5" stroke-linecap="round"/>${drawing}<circle cx="26" cy="24" r="5" fill="#f5b544"/><circle cx="151" cy="100" r="5" fill="#7b91d9"/></svg><div class="cartoon-caption">Ilustrasi kartun: ${c.title}<small>Amati gambar, baca cerita, lalu pilih jawaban.</small></div></div>`}
function addCartoon(container,c){const old=container.querySelector('.cartoon-scene');if(old)old.remove();const q=container.querySelector('#gameQuestion')||container.querySelector('b');const scene=document.createElement('div');scene.innerHTML=cartoon(c);if(q)q.parentNode.insertBefore(scene.firstElementChild,q);}
startCase=function(id){originalStartCase(id);const c=cases.find(x=>x.id===id);if(!c)return;const panel=$('game').querySelector('.panel');addCartoon(panel,c);let audio=$('readQuestion');if(!audio){audio=document.createElement('button');audio.id='readQuestion';audio.className='btn ghost small audio-btn';audio.textContent='🔊 Bacakan soal';$('gameQuestion').insertAdjacentElement('beforebegin',audio)}audio.onclick=()=>{if('speechSynthesis'in window){speechSynthesis.cancel();speechSynthesis.speak(new SpeechSynthesisUtterance(`${c.title}. ${c.story}. ${c.question}. Pilihan: ${c.options.join(', ')}`))}else alert('Fitur audio tidak didukung pada peramban ini.')};};
// Ilustrasi kartun di papan kasus; judul dan keterangan tetap ditampilkan.
renderCases=function(){originalRenderCases();document.querySelectorAll('#caseList .case').forEach((el,i)=>{const c=availableCases()[i];if(!c)return;const icon=el.querySelector('.emoji');if(icon){icon.innerHTML=cartoon(c);icon.style.width='100px';icon.style.height='auto';icon.style.background='transparent';icon.style.display='block';icon.style.overflow='visible';const svg=icon.querySelector('svg');if(svg){svg.style.width='90px';svg.style.height='75px'}}});};
// Extend ruang guru dengan bank soal yang bisa dikelola sebelum sesi dimulai.
const settingsPanel=$('teacherSettings');const editor=document.createElement('div');editor.className='question-editor';editor.innerHTML=`<h3>📝 Bank soal guru</h3><p class="muted">Tambahkan atau ubah soal sebelum sesi. Setiap soal memiliki empat pilihan, petunjuk visual/teks, penjelasan, dan tingkat kesulitan. Perubahan disimpan pada peramban ini.</p><div class="mission-card"><label for="editCase">Pilih soal untuk diedit</label><select id="editCase"></select><label for="editTitle">Judul kasus</label><input id="editTitle"><label for="editStory">Cerita singkat</label><textarea id="editStory" rows="2"></textarea><label for="editQuestion">Pertanyaan</label><textarea id="editQuestion" rows="2"></textarea><div class="editor-grid">${[0,1,2,3].map(i=>`<div><label for="editOption${i}">Pilihan ${String.fromCharCode(65+i)}</label><input id="editOption${i}"></div>`).join('')}</div><label for="editAnswer">Kunci jawaban</label><select id="editAnswer"><option value="0">A</option><option value="1">B</option><option value="2">C</option><option value="3">D</option></select><label for="editHint">Petunjuk (bukan jawaban langsung)</label><textarea id="editHint" rows="2"></textarea><label for="editExplain">Penjelasan guru</label><textarea id="editExplain" rows="2"></textarea><label for="editLevel">Level</label><select id="editLevel"><option value="1">Pemula</option><option value="2">Penjelajah</option><option value="3">Ahli Energi</option></select><div class="row"><button class="btn gold" id="saveQuestion">Simpan soal</button><button class="btn ghost" id="newQuestion">Tambah soal baru</button><button class="btn ghost" id="deleteQuestion">Hapus soal</button></div><div class="toast" id="editorMessage" aria-live="polite"></div></div>`;settingsPanel.appendChild(editor);
function persistBank(){try{localStorage.setItem('detektifEnergiBank',JSON.stringify(cases));localStorage.setItem('detektifEnergiBankVersion','84-soal-source-v1')}catch(e){}}
function loadBank(){try{const saved=JSON.parse(localStorage.getItem('detektifEnergiBank')||'null');if(Array.isArray(saved)&&saved.length>=80){cases.splice(0,cases.length,...saved)}}catch(e){}}
function fillEditor(){const sel=$('editCase');sel.innerHTML=cases.map((c,i)=>`<option value="${c.id}">${c.id}. ${c.title}</option>`).join('');if(cases.length)sel.value=String(cases[0].id);populateEditor()}
function populateEditor(){const c=cases.find(x=>x.id===+$('editCase').value);if(!c)return;$('editTitle').value=c.title;$('editStory').value=c.story;$('editQuestion').value=c.question;c.options.forEach((x,i)=>$('editOption'+i).value=x);$('editAnswer').value=c.answer;$('editHint').value=c.hint;$('editExplain').value=c.explain;$('editLevel').value=c.level}
function clearEditor(){['editTitle','editStory','editQuestion','editHint','editExplain','editOption0','editOption1','editOption2','editOption3'].forEach(id=>$(id).value='');$('editAnswer').value='0';$('editLevel').value='1';$('editCase').value='';$('editorMessage').textContent='Mode tambah: isi judul, cerita, pertanyaan, empat pilihan, kunci, petunjuk, dan penjelasan.'}
$('editCase').addEventListener('change',populateEditor);$('newQuestion').onclick=clearEditor;$('saveQuestion').onclick=()=>{const title=$('editTitle').value.trim(),story=$('editStory').value.trim(),question=$('editQuestion').value.trim(),options=[0,1,2,3].map(i=>$('editOption'+i).value.trim()),hint=$('editHint').value.trim(),explain=$('editExplain').value.trim();if(!title||!story||!question||options.some(x=>!x)||!hint||!explain){$('editorMessage').textContent='Lengkapi semua kolom, termasuk empat pilihan.';return}const id=+$('editCase').value;const old=cases.find(c=>c.id===id);if(old){Object.assign(old,{title,story,question,options,answer:+$('editAnswer').value,hint,explain,why:explain,level:+$('editLevel').value})}else{const nextId=Math.max(0,...cases.map(c=>c.id))+1;cases.push({id:nextId,icon:'🕵️',title,story,question,options,answer:+$('editAnswer').value,hint,explain,why:explain,level:+$('editLevel').value});settings.enabled.push(nextId)}persistBank();fillEditor();renderCases();$('editorMessage').textContent='Soal tersimpan. Periksa kembali sebelum sesi dimulai.'};$('deleteQuestion').onclick=()=>{const id=+$('editCase').value;if(!id){$('editorMessage').textContent='Pilih soal yang akan dihapus.';return}if(cases.length<=1){$('editorMessage').textContent='Bank soal harus menyisakan minimal satu soal.';return}const idx=cases.findIndex(c=>c.id===id);if(idx>=0)cases.splice(idx,1);settings.enabled=settings.enabled.filter(x=>x!==id);persistBank();fillEditor();renderCases();$('editorMessage').textContent='Soal dihapus dari bank lokal.'};
// Petunjuk 3-8-15 poin: tiga penggunaan per tim untuk seluruh sesi.
