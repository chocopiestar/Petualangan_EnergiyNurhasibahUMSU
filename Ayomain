<script id="audio-lanjutan">
/* Rekaman suara guru: unggah lebih fleksibel, rekam langsung, cadangan/impor, dan tombol dengar di ronde tim */
(()=>{
const $=id=>document.getElementById(id);
const DB='detektifEnergiAudioDB';
function db(){return new Promise((res,rej)=>{if(!('indexedDB'in window)){rej(new Error('Penyimpanan audio tidak didukung browser ini.'));return}const r=indexedDB.open(DB,1);r.onupgradeneeded=()=>{if(!r.result.objectStoreNames.contains('recordings'))r.result.createObjectStore('recordings')};r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error)})}
async function tx(mode,fn){const d=await db();return new Promise((res,rej)=>{const t=d.transaction('recordings',mode);const o=fn(t.objectStore('recordings'));t.oncomplete=()=>res(o&&o.result);t.onerror=()=>rej(t.error)})}
const get=id=>tx('readonly',s=>s.get(String(id)));
const put=(id,b)=>tx('readwrite',s=>s.put(b,String(id)));
const keys=()=>tx('readonly',s=>s.getAllKeys());
const MIME={mp3:'audio/mpeg',m4a:'audio/mp4',wav:'audio/wav',aac:'audio/aac',ogg:'audio/ogg',oga:'audio/ogg',opus:'audio/ogg; codecs=opus',amr:'audio/amr',wma:'audio/x-ms-wma',mp4:'video/mp4',webm:'audio/webm','3gp':'audio/3gpp',flac:'audio/flac'};
const ext=n=>(String(n).split('.').pop()||'').toLowerCase();
const b2d=b=>new Promise(r=>{const f=new FileReader();f.onload=()=>r(f.result);f.readAsDataURL(b)});
function d2b(u){const m=/^data:([^;,]*)(;base64)?,(.*)$/.exec(u);const bin=atob(m[3]);const a=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)a[i]=bin.charCodeAt(i);return new Blob([a],{type:m[1]||'audio/mpeg'})}
let cur=null;
function stop(){if(cur){try{cur.pause()}catch(e){}cur=null}}
function flash(btn,t){const o=btn.dataset.o||btn.textContent;btn.dataset.o=o;btn.textContent=t;setTimeout(()=>{btn.textContent=o},2200)}
async function play(id,btn){try{const blob=await get(id);if(!blob){flash(btn,'Belum ada rekaman');return}stop();const url=URL.createObjectURL(blob);cur=new Audio(url);cur.onended=()=>{URL.revokeObjectURL(url);cur=null};await cur.play()}catch(e){flash(btn,'Gagal diputar')}}
/* ---------- editor Mode Guru ---------- */
const ST=$('audioEditorStatus');
if(ST&&$('saveQuestionAudio')){
 const info=document.createElement('p');info.id='audioCount';info.className='muted';ST.insertAdjacentElement('afterend',info);
 const refresh=()=>keys().then(k=>{info.textContent='Soal yang sudah punya rekaman di perangkat ini: '+k.length}).catch(()=>{info.textContent='Penyimpanan rekaman tidak tersedia di browser ini.'});
 refresh();
 $('saveQuestionAudio').onclick=async()=>{
  const id=$('editCase').value,f=$('questionAudioFile').files[0];
  if(!id){ST.textContent='Pilih soal terlebih dahulu.';return}
  if(!f){ST.textContent='Pilih file audio terlebih dahulu.';return}
  if(!(f.type.startsWith('audio/')||f.type.startsWith('video/')||MIME[ext(f.name)])){ST.textContent='Format file tidak dikenali ('+(f.type||'tanpa tipe')+', '+f.name+'). Gunakan MP3, M4A, WAV, atau tombol Rekam langsung.';return}
  try{const blob=f.type?f:new Blob([f],{type:MIME[ext(f.name)]});await put(id,blob);ST.textContent='Rekaman tersimpan untuk soal ini ('+Math.round(f.size/1024)+' KB). Klik Dengarkan untuk mencoba.';refresh()}
  catch(e){ST.textContent='Rekaman tidak dapat disimpan: '+(e&&e.message?e.message:'penyimpanan browser ditolak.')}};
 const row=document.createElement('div');row.className='row';row.style.marginBottom='8px';
 row.innerHTML='<button type="button" class="btn ghost" id="recQ">⏺ Rekam langsung</button><button type="button" class="btn ghost" id="stopQ" disabled>⏹ Berhenti dan simpan</button><button type="button" class="btn ghost" id="expQ">⬇ Cadangkan semua rekaman</button><button type="button" class="btn ghost" id="impQ">⬆ Impor cadangan</button><input type="file" id="impFile" accept=".json,application/json" style="display:none">';
 $('saveQuestionAudio').parentElement.insertAdjacentElement('beforebegin',row);
 let mr=null,chunks=[],stream=null;
 $('recQ').onclick=async()=>{
  const id=$('editCase').value;if(!id){ST.textContent='Pilih soal terlebih dahulu.';return}
  if(!navigator.mediaDevices||!window.MediaRecorder){ST.textContent='Perekaman langsung tidak didukung browser ini. Gunakan unggah file.';return}
  try{stream=await navigator.mediaDevices.getUserMedia({audio:true})}catch(e){ST.textContent='Mikrofon tidak dapat dipakai. Izinkan mikrofon pada ikon gembok di samping alamat halaman (halaman harus beralamat https).';return}
  chunks=[];mr=new MediaRecorder(stream);
  mr.ondataavailable=e=>{if(e.data&&e.data.size)chunks.push(e.data)};
  mr.onstop=async()=>{stream.getTracks().forEach(t=>t.stop());const blob=new Blob(chunks,{type:mr.mimeType||'audio/webm'});
   try{await put(id,blob);ST.textContent='Rekaman tersimpan ('+Math.round(blob.size/1024)+' KB). Klik Dengarkan untuk mencoba.';refresh()}catch(e){ST.textContent='Rekaman tidak dapat disimpan.'}
   $('recQ').disabled=false;$('stopQ').disabled=true};
  mr.start();ST.textContent='Sedang merekam... bacakan soal, lalu klik Berhenti dan simpan.';$('recQ').disabled=true;$('stopQ').disabled=false};
 $('stopQ').onclick=()=>{if(mr&&mr.state==='recording')mr.stop()};
 $('expQ').onclick=async()=>{try{const k=await keys();if(!k.length){ST.textContent='Belum ada rekaman untuk dicadangkan.';return}const out={};for(const id of k){const b=await get(id);out[id]=await b2d(b)}
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(out)],{type:'application/json'}));a.download='rekaman-detektif-energi.json';document.body.appendChild(a);a.click();a.remove();ST.textContent='Cadangan diunduh: '+k.length+' rekaman.'}catch(e){ST.textContent='Cadangan gagal dibuat.'}};
 $('impQ').onclick=()=>$('impFile').click();
 $('impFile').onchange=async()=>{const f=$('impFile').files[0];if(!f)return;try{const o=JSON.parse(await f.text());let n=0;for(const id of Object.keys(o)){await put(id,d2b(o[id]));n++}ST.textContent='Impor berhasil: '+n+' rekaman.';refresh()}catch(e){ST.textContent='File cadangan tidak valid.'}};
}
/* ---------- tombol dengar di ronde 4 tim ---------- */
const prevR=renderMultiRound;
renderMultiRound=function(){prevR();
 [...$('playerGrid').children].forEach(card=>{
  if(!card.classList.contains('player-card')||card.querySelector('.audio-btn'))return;
  const id=+card.dataset.caseId,pa=card.querySelector('.player-answers');if(!pa)return;
  const b=document.createElement('button');b.type='button';b.className='btn ghost small audio-btn';b.textContent='🎙️ Dengarkan soal';b.style.margin='6px 0';
  b.onclick=()=>play(id,b);pa.insertAdjacentElement('beforebegin',b)})};
})();

